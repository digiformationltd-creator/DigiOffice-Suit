# DigiOffice Suite Git Ignore
# Ignore all work folders, binaries, scratch files, and untracked artifacts
app_extracted/
digioffice_app/
GenOffice*
FINAL/
DigiOffice-Suite-*
__pycache__/
*.exe
*.zip
*.lnk
*.bat
*.iss
*.ps1
*.mjs
*.py
*.txt
*.html
*.svg
*.png
*.ico
*.json
*.js
node_modules/
.DS_Store
Thumbs.db

# Allow assets directory and images
!assets/
!assets/**
